    "poiView": {
        // filter: 一覧の絞り込みに地図アイコンも連動 / all: 地図アイコンは全件表示を維持
        "poiFilter": "filter",
        "poiActLoad": true,
        "poiZoom": {
            "activity": 8,
            "historic": 16,
            "natural": 16,
            "amenity": 16,
            "shop": 16,
            "indoor": 18,
            "parking": 16,
            "publicArt": 14,
            "Green": 15
        },
        "mobilePoiZoom": {
            "indoor": 17
        },
        "editZoom": {
            "JusoArtFes": 14
        }
    },
    "poiData": {
        "maxFeatures": 12000,
        "pruneThreshold": 15000,
        "applyToStatic": false
    },
    "selectItem": {
        "default": "activity",
        "menu": "",
        "action": ""
    },
    "sideBar": {
        "everyView": true,
        "initView": "view"
    },
    "listTable": {
        "nameFallback": "category",
        "backgroundImage": "./image/bgimage.png",
        "category": "activity",
        "target": "activity",
        "allActs": true,
        "playback": {
            "view": false,
            "zoomLevel": 15,
            "timer": 4000
