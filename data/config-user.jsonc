    "icon": {
        "fgPath": "icon",
        "bgPath": "image",
        "flagPath": "./flags/w40",
        "shadow": 0.7,
        "attention": 0.7,
        "green": 0.7,
        "middle": 0.7,
        "visited": 0.5,
        "normal": 0.7,
        "flag": 0.6,
        "textFont": [
            "Noto Sans Regular"
